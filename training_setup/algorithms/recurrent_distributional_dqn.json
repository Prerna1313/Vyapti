{
  "schema": "vyapti_algorithm_spec_v1",
  "name": "recurrent_distributional_dqn",
  "module": "vyapti_simulator.system_b.tsrd.policies.recurrent_distributional_dqn",
  "api": "public_transitions",
  "checkpoint_extension": ".pt",
  "belief_model_spec": "../belief_models/train250_observed_band_hmm.json",
  "settings": {
    "description": "Single-learner recurrent distributional Double-Dueling DQN with sequence-prioritized replay and a receiver-causal 253-feature state.",
    "hidden_units": 256,
    "learning_rate": 0.0001,
    "gamma_per_base_slot": 0.997,
    "n_step": 5,
    "batch_size": 16,
    "replay_capacity_steps": 200000,
    "min_replay_sequences": 128,
    "updates_per_episode": 8,
    "burn_in": 32,
    "learning_sequence": 64,
    "sequence_stride": 8,
    "target_update_interval": 1000,
    "max_grad_norm": 10.0,
    "per_alpha": 0.9,
    "per_beta_start": 0.6,
    "per_beta_end": 1.0,
    "per_priority_eta": 0.9,
    "n_quantiles": 32,
    "n_target_quantiles": 32,
    "quantile_embed_dim": 64,
    "quantile_huber_k": 1.0,
    "noisy_sigma0": 0.5,
    "warmup_actions": 5000,
    "training_action_target": 400000,
    "periodicity_history": 32,
    "base_slot_seconds": 0.05,
    "detection_probability": 0.9,
    "false_alarm_probability": 0.05,
    "device": "auto",
    "cpu_threads": 1
  }
}
