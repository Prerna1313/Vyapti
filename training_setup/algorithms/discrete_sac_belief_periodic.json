{
  "schema": "vyapti_algorithm_spec_v1",
  "name": "discrete_sac_belief_periodic",
  "module": "vyapti_simulator.system_b.tsrd.policies.discrete_sac_belief_periodic",
  "api": "public_transitions",
  "checkpoint_extension": ".pt",
  "belief_model_spec": "../belief_models/train250_observed_band_hmm.json",
  "settings": {
    "description": "Discrete SAC with a causal two-state HMM occupancy belief and causal dwell-level periodicity score and confidence features.",
    "replay_capacity": 500000,
    "min_replay_size": 5000,
    "warmup_actions": 5000,
    "batch_size": 256,
    "update_every_actions": 1,
    "updates_per_action": 1,
    "hidden_units": 256,
    "actor_learning_rate": 0.0003,
    "critic_learning_rate": 0.0003,
    "temperature_learning_rate": 0.0003,
    "gamma_per_base_slot": 0.997,
    "target_update_tau": 0.005,
    "target_entropy_fraction": 0.98,
    "initial_alpha": 0.2,
    "periodicity_history": 32,
    "periodicity_tolerance_fraction": 0.15,
    "base_slot_seconds": 0.05,
    "retune_seconds": 0.0003,
    "detection_probability": 0.9,
    "false_alarm_probability": 0.05,
    "device": "auto",
    "cpu_threads": 1
  }
}
