{
  "schema": "mode_b_evaluation_protocol",
  "data_inventory": {
    "train_source_files": 250,
    "val_source_files": 50,
    "test_source_files": 50,
    "val_role": "fixed_model_selection",
    "test_role": "sealed_final_evaluation",
    "test_requires_explicit_final": true,
    "separate_dev_val_final_val": false,
    "reason": "Current corpus provides only 50 VAL files; do not reuse them as independent DEV-VAL and FINAL-VAL sets."
  },
  "training_seeds": {
    "development": [11, 22, 33],
    "final_comparison": [101, 202, 303, 404, 505]
  },
  "primary_metric": "opportunity_interception_ratio",
  "canonical_receiver": {
    "mission_duration_s": 30.0,
    "base_slot_duration_ms": 50.0,
    "base_slots": 600,
    "band_count": 36,
    "receiver_bandwidth_mhz": 1000.0,
    "band_spacing_mhz": 500.0,
    "spectrum_mhz": [0.0, 18000.0],
    "band_change_retune_ms": 0.3,
    "same_band_retune_ms": 0.0,
    "dwell_profile_source": "retained TRAIN SCAN metadata",
    "dwell_50ms_band_count": 29,
    "dwell_100ms_band_count": 7,
    "dwell_100ms_band_indices_zero_based": [0, 1, 6, 7, 17, 18, 19],
    "retune_value_status": "published QoS ES search simulation parameter, not a universal hardware claim"
  },
  "training_reward": {
    "name": "truth_based_intercept_utility_v2",
    "equation": "N_new/E - (U_before/E)*(dwell_seconds + 0.0003*switch)/30 - lambda_fa*(F_t/N_empty_t)*(dwell_seconds + 0.0003*switch)/30",
    "new_intercept_utility": "N_new / E; credit at most the strongest-amplitude emitter in each positive occupied binary_v1 base-slot look; deduplicate first interceptions across the episode",
    "elapsed_cost": "(unresolved emitters before action / eligible emitters) * (dwell seconds + band-change retune seconds) / 30 seconds",
    "false_alarm_cost": "lambda_fa * (false-positive empty base-slot looks / empty base-slot opportunities) * (dwell + retune) / 30 seconds; zero when there are no empty opportunities",
    "lambda_fa": 1.0,
    "retune_dead_time_s": 0.0003,
    "truth_channel": "scalar reward only; no emitter identity or hidden truth in observation"
  },
  "oracle": {
    "label": "Privileged Oracle Scheduler / Upper-Bound Scheduler",
    "oir_gap": "per_world_oir_privileged_minus_policy_with_paired_95_percent_ci",
    "ttfi": "report_distribution_and_censoring_separately; ratio_policy_over_privileged_when_defined",
    "available_in_current_evaluator": true,
    "absolute_optimum_claim": false
  },
  "frequency_agility": {
    "source": "complete_unmodified_train_tsrd_emitter_trajectories",
    "regimes": ["low", "medium", "high"],
    "fit_on_train_only": true,
    "channel_width_mhz": 500.0,
    "channel_origin_mhz": 0.0,
    "primary_feature": "mean_emitter_channel_transition_rate_hz",
    "dataset_paper": "https://arxiv.org/html/2602.03856v2",
    "features": [
      "observed_channel_transition_rate_hz",
      "median_complete_channel_dwell_s",
      "frequency_span_mhz",
      "distinct_observed_frequencies",
      "distinct_channels_visited",
      "transition_interval_time_fraction"
    ],
    "synthetic_hop_transformations_in_primary_suite": false,
    "stratified_replay_implemented": true
  },
  "prediction_metrics": {
    "required_for_all_algorithms": false,
    "optional_target": "next_slot_activity_probability_for_36_bands",
    "metrics": ["brier_score", "log_loss", "calibration", "per_band_precision_recall_f1"],
    "intercept_time_error_requires_explicit_prediction": true
  },
  "uncertainty": {
    "world_comparison": "paired_per_world_metric_differences",
    "bootstrap": "paired_percentile_resampling_with_replacement",
    "confidence": 0.95,
    "resamples": 10000,
    "bootstrap_seed": 20261002,
    "seed_variability_reported_separately": true
  },
  "conditions": ["normal", "beam_periodic", "beam_stochastic"],
  "test_policy": "evaluate_once_after_checkpoint_and_analysis_are_frozen"
}
