# Byte-compiled / optimized
__pycache__/
*.py[cod]
*.so

# Tests and reusable experiment scripts are source code and are tracked.
# Ignore generated outputs below, and keep large/local datasets out explicitly.

# All experiment outputs
/runs/
results/
exp_results/
vyapti_figs/
data_provenance/*

# Local TSRD source recordings and reusable NPZ caches
/Data/

# Research documentation (not simulator docs)
research_docs/

# Development status tracker (internal team artifact)
SIMULATOR_STATUS.md

# Loose experiment artifacts at the repo root
*.json
!/training_setup/**/*.json
!pyproject.toml
!/experiments/configs/*.json
!/tests/fixtures/tsrd/manifest.json
!/data_provenance/manifest.json
!/data_provenance/tsrd_corpus_manifest.json
*.csv
*.png
*.pdf
*.txt
replace_script.py

# Local Kaggle mirror (keep one copy only — the repo root version)
vyapti-simulator-kaggle/

# Locally downloaded TSRD samples/corpus. Small committed fixtures under
# tests/fixtures remain trackable.
/3/
/4/
/tsrd-data/
/dataset/
/.baseline_deps/

# OS
.DS_Store
Thumbs.db

# Python
*.egg-info/
dist/
build/

# Frontend assets
!frontend/**/*.png
